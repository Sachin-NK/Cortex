# -----------------------------------------------------------------------------
# Cortex - Multi-Model AI Agent Harness
# Environment Configuration
#
# Copy to .env and fill in your values.
#   cp .env.example .env
#
# You need at least ONE provider API key to use Cortex.
# Every key is optional - Cortex gracefully skips unconfigured providers.
# -----------------------------------------------------------------------------


# -- AI Provider API Keys ------------------------------------------------------
# Cortex routing policy (default: balanced):
#   Code generation & debugging  →  DeepSeek (primary)
#   Long context & repo analysis →  Kimi (primary)
#   Multimodal & architecture    →  Gemini (primary)
#   Structured output & security →  OpenAI (primary)
#   Final review & orchestration →  Claude (limited to 3 calls/workflow)

# OpenAI - structured output, security review, independent verification
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic - orchestration, architecture approval, final quality gate ONLY
# (Claude token budget is enforced - routine tasks are delegated away)
# https://console.anthropic.com/keys
ANTHROPIC_API_KEY=

# Google Gemini - multimodal, architecture design, long-context review
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# DeepSeek - primary coding, debugging, refactoring, test generation
# https://platform.deepseek.com/api-keys
DEEPSEEK_API_KEY=

# Kimi (Moonshot AI) - long-context analysis, repository understanding,
# large document processing, research synthesis
# https://platform.moonshot.cn/console/api-keys
KIMI_API_KEY=

# OpenRouter - optional gateway giving access to 100+ models via one key
# Useful as a fallback or when you want to route through multiple model
# families without managing individual keys.
# https://openrouter.ai/keys
OPENROUTER_API_KEY=


# -- Web Search (MCP Tool) -----------------------------------------------------
# Required for the web_search MCP tool (Google Search via Serper API).
# Get a free key at https://serper.dev (2,500 searches/month free tier).
SERPER_API_KEY=


# -- Privacy Tier --------------------------------------------------------------
# Controls which providers may receive your prompts and context.
#
#   standard  - All configured providers available (default)
#   sensitive - Blocks DeepSeek and Kimi. Use when prompts may contain
#               proprietary code, internal architecture, or business data.
#               (DeepSeek and Kimi have less transparent data policies.)
#   strict    - Only Anthropic. Use for healthcare, legal, or financial
#               content. Anthropic has the strongest documented API data
#               policy with no training on API inputs by default.
#
PRIVACY_TIER=standard


# -- Workflow State / Checkpointing --------------------------------------------
# SQLite database path for workflow checkpointing and resumption.
# Workflows are saved here so they can be resumed after a restart.
CORTEX_STATE_DB=/tmp/cortex_state.db


# -- Mock Provider (Local Testing) --------------------------------------------
# Set to "true" to enable a deterministic mock provider that returns
# stub responses without making any real API calls. Safe for CI/CD.
ENABLE_MOCK_PROVIDER=false
